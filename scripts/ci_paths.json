{
  "jobs": ["app", "app-windows", "python"],
  "always_all": [".github/workflows/", "scripts/ci_changes.py", "scripts/ci_paths.json", "scripts/test_ci_changes.py"],
  "rules": [
    {"prefix": "core/", "jobs": ["app", "app-windows"]},
    {"prefix": "third_party/", "jobs": ["app", "app-windows"]},
    {"prefix": "CMakeLists.txt", "jobs": ["app", "app-windows"]},
    {"prefix": "CMakePresets.json", "jobs": ["app", "app-windows"]},
    {"prefix": "cmake/", "jobs": ["app", "app-windows"]},
    {"prefix": "sim/", "jobs": ["app", "app-windows"]},
    {"prefix": "eval/", "jobs": ["app", "app-windows"]},
    {"prefix": "tools/", "jobs": ["app", "app-windows"]},
    {"prefix": "bridge/", "jobs": ["python"]},
    {"prefix": "perception/", "jobs": ["python"]},
    {"prefix": "scenarios/", "jobs": ["python"]},
    {"prefix": "viewer/", "jobs": ["python"]},
    {"prefix": "scripts/", "jobs": ["python"]},
    {"prefix": "docs/", "jobs": ["app"]}
  ],
  "md_read_by_tests": {"docs/BASELINE.md": ["app", "app-windows"], "eval/README.md": ["app", "app-windows"], "docs/INVESTIGATION-ASSOCIATION.md": ["app", "app-windows"]},
  "seed_paths": [".github/workflows/"]
}
