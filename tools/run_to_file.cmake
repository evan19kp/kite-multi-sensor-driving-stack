execute_process(COMMAND ${EXE} ${ARGS}
  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
message("${out}")
if(NOT rc STREQUAL "0")
  message(FATAL_ERROR "exit code ${rc}, expected 0: ${err}")
endif()
string(REPLACE "\r\n" "\n" out "${out}")
if(DEFINED EXPECT_MATCH AND NOT out MATCHES "${EXPECT_MATCH}")
  message(FATAL_ERROR "stdout does not match: ${EXPECT_MATCH}")
endif()
file(CONFIGURE OUTPUT ${OUT} CONTENT "${out}" @ONLY NEWLINE_STYLE UNIX)
