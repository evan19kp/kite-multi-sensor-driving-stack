file(READ ${TABLE} table)
file(READ ${DOC} doc)
string(REPLACE "\r\n" "\n" table "${table}")
string(REPLACE "\r\n" "\n" doc "${doc}")
if(table STREQUAL "")
  message(FATAL_ERROR "${TABLE} is empty")
endif()
string(FIND "\n${doc}" "\n${table}" position)
if(position EQUAL -1)
  message(FATAL_ERROR "${DOC} does not contain the exact output in ${TABLE}")
endif()
