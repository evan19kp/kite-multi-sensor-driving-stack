file(READ ${LOG} content)
string(REPLACE "\r\n" "\n" content "${content}")
file(CONFIGURE OUTPUT ${COPY} CONTENT "${content}" @ONLY NEWLINE_STYLE UNIX)
execute_process(COMMAND ${EXE} --log ${COPY}
  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
message("stdout: ${out}")
message("stderr: ${err}")
if(NOT rc STREQUAL "0")
  message(FATAL_ERROR "exit code ${rc}, expected 0")
endif()
string(REPLACE "\r\n" "\n" out "${out}")
if(NOT out STREQUAL "${EXPECT_STDOUT}\n")
  message(FATAL_ERROR "stdout is not exactly: ${EXPECT_STDOUT}")
endif()
