function(run_or_fail)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  message("stdout: ${out}")
  message("stderr: ${err}")
  if(NOT rc STREQUAL "0")
    message(FATAL_ERROR "exit code ${rc}, expected 0")
  endif()
  set(run_stdout "${out}" PARENT_SCOPE)
endfunction()

set(tracked ${WORK}/${NAME}.log)
run_or_fail(${TRACK} --in ${IN} --tracker ${TRACKER} --out ${tracked})

file(READ ${tracked} tracked_hex HEX)
file(READ ${GOLDEN} golden_hex HEX)
if(NOT tracked_hex STREQUAL golden_hex)
  message(FATAL_ERROR "${tracked} is not byte-identical to ${GOLDEN}")
endif()

file(STRINGS ${IN} input_records REGEX "^(#|gt,|meas,)")
file(STRINGS ${tracked} kept_records REGEX "^(#|gt,|meas,)")
if(NOT input_records STREQUAL kept_records)
  message(FATAL_ERROR "the output changed a header, gt or meas record of the input")
endif()

run_or_fail(${SCORE} --log ${tracked})
string(REPLACE "\r\n" "\n" run_stdout "${run_stdout}")
if(NOT run_stdout STREQUAL "${EXPECT_STDOUT}\n")
  message(FATAL_ERROR "score is not exactly: ${EXPECT_STDOUT}")
endif()

file(STRINGS ${IN} without_gt)
list(FILTER without_gt EXCLUDE REGEX "^gt,")
list(JOIN without_gt "\n" without_gt_text)
file(CONFIGURE OUTPUT ${WORK}/${NAME}_no_gt_in.log CONTENT "${without_gt_text}\n" @ONLY
     NEWLINE_STYLE UNIX)
run_or_fail(${TRACK} --in ${WORK}/${NAME}_no_gt_in.log --tracker ${TRACKER}
            --out ${WORK}/${NAME}_no_gt_out.log)
file(STRINGS ${tracked} tracks REGEX "^track,")
file(STRINGS ${WORK}/${NAME}_no_gt_out.log tracks_without_gt REGEX "^track,")
if(NOT tracks)
  message(FATAL_ERROR "the output has no track records")
endif()
if(NOT tracks STREQUAL tracks_without_gt)
  message(FATAL_ERROR "tracks changed when the gt records were removed from the input")
endif()
