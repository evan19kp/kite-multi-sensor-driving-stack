get_filename_component(tool ${EXE} NAME_WE)
if(NOT DEFINED ERROR_TEXT)
  set(ERROR_TEXT "cannot write")
endif()
execute_process(COMMAND ${EXE} ${ARGS}
  RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
message("stdout: ${out}")
message("stderr: ${err}")
if(NOT rc STREQUAL EXPECT)
  message(FATAL_ERROR "exit code ${rc}, expected ${EXPECT}")
endif()
if(EXPECT STREQUAL "2" AND NOT err MATCHES "usage: ${tool}")
  message(FATAL_ERROR "exit code 2 without the usage text on stderr")
endif()
if(EXPECT STREQUAL "1" AND NOT err MATCHES "${ERROR_TEXT}")
  message(FATAL_ERROR "exit code 1 without the ${ERROR_TEXT} message on stderr")
endif()
